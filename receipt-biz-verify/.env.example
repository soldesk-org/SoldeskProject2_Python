# receipt-biz-verify 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣는다 (.env 는 git에 올라가지 않음)

# 사업자등록증명원 OCR — Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 국세청 사업자등록 진위확인 API (data.go.kr)
NTS_SERVICE_KEY=

# 영수증 OCR 보조 (Upstage)
UPSTAGE_API_KEY=

# CORS 허용 오리진 (쉼표 구분). Spring이 프록시하므로 보통 비워둬도 된다.
ALLOWED_ORIGINS=

# 서버 대 서버 인증(2026-08-08 추가) — Spring 백엔드가 X-Internal-Token 헤더로 이 값을 보낸다.
# 이 값이 비어있으면 검사를 건너뛴다(로컬 개발용). 운영(VM)에서는 반드시 채우고, Spring 쪽
# application.yml의 business-verify.internal-token(= 환경변수 BUSINESS_VERIFY_INTERNAL_TOKEN)과
# 정확히 같은 값이어야 한다.
INTERNAL_API_TOKEN=
