# keyword-extraction (AI 추천) 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣는다 (.env 는 git에 올라가지 않음)

# 카카오 로컬 API (장소 검색)
KAKAO_REST_API_KEY=

# 사용할 LLM 모델 (GPU 필요)
FOOTTRIP_MODEL_NAME=kakaocorp/kanana-nano-2.1b-instruct

# 리뷰 태그 비율 조회용 백엔드 엔드포인트
REVIEW_STATS_URL=http://127.0.0.1:8081/internal/reviews/keyword-ratios

# --- 선택 값 (미지정 시 코드 기본값 사용) ---
# FOOTTRIP_DEFAULT_RESULT_SIZE=
# FOOTTRIP_HTTP_TIMEOUT=
# FOOTTRIP_MAX_CATEGORY_EXPANSIONS=
# FOOTTRIP_MAX_KAKAO_QUERIES=
# FOOTTRIP_MIN_REVIEW_COUNT=
